            "value": "스위치를 켠 뒤 여기로 돌아오세요(재시작 불필요)"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Activez l’interrupteur puis revenez ici (pas de redémarrage)"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schalter einschalten und zurückkehren (kein Neustart)"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Activa el interruptor y vuelve aquí (sin reiniciar)"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ligue o interruptor e volte aqui (sem reiniciar)"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Attiva l’interruttore e torna qui (senza riavvio)"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Включите переключатель и вернитесь сюда (без перезапуска)"
