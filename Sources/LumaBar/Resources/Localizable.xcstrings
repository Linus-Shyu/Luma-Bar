    "voice.open_mic_settings": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enable luma bar in System Settings → Privacy & Security → Microphone, then retry Voice Whisper."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
