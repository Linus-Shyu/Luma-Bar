    "permission.subtitle": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turn these on so Luma Bar can work fully. Status refreshes when you return from System Settings."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "开启下列能力后，Luma Bar 才能完整工作。从系统设置返回时会自动刷新状态。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "開啟下列能力後，Luma Bar 才能完整運作。從系統設定返回時會自動重新整理狀態。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "これらをオンにすると Luma Bar が十分に動作します。システム設定から戻ると状態が更新されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다음을 켜면 Luma Bar가 제대로 동작합니다. 시스템 설정에서 돌아오면 상태가 새로고침됩니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Activez ces options pour que Luma Bar fonctionne pleinement. L’état se met à jour au retour des Réglages Système."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schalten Sie diese Rechte ein, damit Luma Bar voll funktioniert. Status aktualisiert sich nach den Systemeinstellungen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Actívalos para que Luma Bar funcione por completo. El estado se actualiza al volver de Ajustes del Sistema."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ative estes itens para o Luma Bar funcionar por completo. O status atualiza ao voltar dos Ajustes do Sistema."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Attivali così Luma Bar funziona al meglio. Lo stato si aggiorna tornando dalle Impostazioni di Sistema."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Включите эти разрешения, чтобы Luma Bar работал полностью. Статус обновится после возврата из Системных настроек."
          }
        }
      }
    },
