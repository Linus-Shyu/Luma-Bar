          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請在「系統設定 → 隱私權與安全性 → 麥克風」中開啟 luma bar，然後重試 Voice Whisper。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "システム設定 → プライバシーとセキュリティ → マイク で luma bar を有効にしてから Voice Whisper を再試行してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시스템 설정 → 개인정보 보호 및 보안 → 마이크에서 luma bar를 켠 뒤 Voice Whisper를 다시 시도하세요."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Activez luma bar dans Réglages Système → Confidentialité et sécurité → Microphone, puis réessayez Voice Whisper."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktivieren Sie luma bar unter Systemeinstellungen → Datenschutz & Sicherheit → Mikrofon, dann Voice Whisper erneut versuchen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Activa luma bar en Ajustes del Sistema → Privacidad y seguridad → Micrófono y vuelve a intentar Voice Whisper."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ative o luma bar em Ajustes do Sistema → Privacidade e segurança → Microfone e tente o Voice Whisper de novo."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Attiva luma bar in Impostazioni di Sistema → Privacy e sicurezza → Microfono, poi riprova Voice Whisper."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Включите luma bar в Системных настройках → Конфиденциальность и безопасность → Микрофон, затем повторите Voice Whisper."
          }
        }
      }
    },
