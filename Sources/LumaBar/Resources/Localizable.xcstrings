    "help.feature.agent.detail": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Switch to Agent in the panel; use shortcuts or voice for confirmed local actions."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在展开面板中切换到 Agent，用快捷键或语音下达本地确认动作。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在展開面板切換到 Agent，用快捷鍵或語音執行需確認的本機動作。"
          }
        },
        "ja": {
