          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ou abra Automação e permita Music / Eventos do Sistema"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Oppure apri Automazione e consenti Music / Eventi di Sistema"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Или откройте Автоматизацию и разрешите Music / Системные события"
