    "help.feature.hover.detail": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Move the pointer to the notch / top bar to expand; move away to collapse."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将指针移到刘海 / 顶栏区域，面板会自动展开；移开后收起。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "將指標移到瀏海 / 頂列區域即可展開；移開後收起。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ノッチ/上部バーにポインタを置くと展開し、離すと閉じます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "노치/상단 바에 포인터를 올리면 펼쳐지고 벗어나면 접힙니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Placez le pointeur sur le notch / barre supérieure pour développer ; éloignez-le pour réduire."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeiger auf Notch/obere Leiste bewegen zum Erweitern; weg bewegen zum Einklappen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mueve el puntero al notch / barra superior para ampliar; aléjalo para contraer."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mova o ponteiro para o notch / barra superior para expandir; afaste para recolher."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sposta il puntatore sul notch / barra superiore per espandere; allontanati per comprimere."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Наведите указатель на вырез / верхнюю полосу, чтобы раскрыть; уберите — чтобы свернуть."
          }
        }
      }
    },
