          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Appuyez sur Autoriser et choisissez OK"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erlauben tippen und im Dialog OK wählen"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pulsa Permitir y elige OK"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque em Permitir e escolha OK"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tocca Consenti e scegli OK"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нажмите «Разрешить» и выберите OK"
          }
        }
      }
    },
    "permission.guide.automation.2": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Or open Privacy & Security → Automation and allow Music / System Events"
