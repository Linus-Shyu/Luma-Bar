    "permission.tip.accessibility": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Selection translation still needs Accessibility — reopen Permissions from the menu."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "划词翻译还需开启「辅助功能」，可在菜单栏 → 权限设置再开。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "劃詞翻譯還需開啟「輔助使用」，可在選單列 → 權限設定再開。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "選択翻訳にはアクセシビリティが必要です。メニューから権限を再度開いてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "선택 번역에는 손쉬운 사용이 필요합니다. 메뉴에서 권한을 다시 여세요."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La traduction de sélection nécessite l’Accessibilité — rouvrez Autorisations dans le menu."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auswahlübersetzung braucht Bedienungshilfen — Rechte erneut im Menü öffnen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La traducción de selección necesita Accesibilidad — vuelve a abrir Permisos en el menú."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A tradução de seleção precisa de Acessibilidade — reabra Permissões no menu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La traduzione selezione richiede Accessibilità — riapri Permessi dal menu."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Для перевода выделения нужен Универсальный доступ — снова откройте Доступ в меню."
          }
        }
      }
    },
    "permission.tip.automation": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Music sync needs Automation; playback controls may be unavailable for now."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "音乐同步需要「自动化」权限，播放控制可能暂时不可用。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "音樂同步需要「自動化」權限，播放控制可能暫時無法使用。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "音楽同期にはオートメーションが必要です。再生操作が使えない場合があります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "음악 동기화에는 자동화가 필요합니다. 재생 제어가 잠시 안 될 수 있습니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La sync musicale nécessite l’Automatisation ; les commandes de lecture peuvent être indisponibles."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Musiksync braucht Automation; Wiedergabesteuerung kann fehlen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La sync de música necesita Automatización; los controles de reproducción pueden no estar disponibles."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A sync de música precisa de Automação; os controles de reprodução podem ficar indisponíveis."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La sync musica richiede Automazione; i controlli di riproduzione potrebbero non essere disponibili."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Для синхронизации музыки нужна Автоматизация; управление воспроизведением может быть недоступно."
          }
        }
      }
    },
