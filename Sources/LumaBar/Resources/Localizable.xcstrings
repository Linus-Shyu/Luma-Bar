    "permission.core_warning": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can continue without core permissions, but selection translation / music sync may be unavailable."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "核心权限未完成时仍可进入，但划词 / 音乐同步可能不可用。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "核心權限未完成時仍可進入，但劃詞 / 音樂同步可能無法使用。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "必須権限がなくても入れますが、選択翻訳や音楽同期は使えない場合があります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "핵심 권한 없이도 들어갈 수 있지만 선택 번역/음악 동기화가 안 될 수 있습니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous pouvez continuer sans elles, mais la traduction de sélection / synchronisation musicale peut être indisponible."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ohne Kernrechte geht es weiter, aber Auswahlübersetzung / Musiksync können fehlen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Puedes continuar sin ellos, pero la traducción de selección / sync de música puede no estar disponible."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você pode continuar sem elas, mas a tradução de seleção / sync de música pode ficar indisponível."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Puoi continuare senza, ma traduzione selezione / sync musica potrebbero non essere disponibili."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Можно продолжить без них, но перевод выделения / синхронизация музыки могут быть недоступны."
          }
        }
      }
    },
