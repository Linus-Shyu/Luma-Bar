      }
    },
    "permission.guide.automation.1": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap Allow and choose OK in the system prompt"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点击「授权」弹出系统询问时选择「好」"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "點一下「授權」，並在系統詢問時選擇「好」"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「許可」を押し、システムダイアログで OK"
