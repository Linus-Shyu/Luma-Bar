    "help.footer": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This guide opens only when you ask for it — never on launch."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本指南仅在你主动打开时出现，不会在启动时自动弹出。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "本指南只會在你主動開啟時出現，不會在啟動時自動彈出。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このガイドは必要なときだけ開き、起動時には表示されません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 가이드는 필요할 때만 열리며 실행 시 자동으로 나타나지 않습니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce guide ne s’ouvre que lorsque vous le demandez — jamais au lancement."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Anleitung öffnet sich nur auf Anfrage — nie beim Start."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta guía solo se abre cuando la pides — nunca al iniciar."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este guia só abre quando você pede — nunca na inicialização."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questa guida si apre solo su richiesta — mai all’avvio."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это руководство открывается только по запросу — не при запуске."
          }
        }
      }
    },
