    "help.shortcut.toggle_panel.detail": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Summon the expanded panel anytime; press again to dismiss."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "随时呼出展开界面；再按一次即可收起。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "隨時呼出展開介面；再按一次即可收起。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "いつでも展開パネルを呼び出し、もう一度押すと閉じます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "언제든 확장 패널을 열고, 다시 누르면 닫습니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Appelez le panneau étendu à tout moment ; appuyez à nouveau pour le fermer."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erweitertes Panel jederzeit aufrufen; erneut drücken zum Schließen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre el panel ampliado en cualquier momento; pulsa de nuevo para cerrarlo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Abra o painel expandido a qualquer momento; pressione de novo para fechar."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Apri il pannello espanso in qualsiasi momento; premi di nuovo per chiudere."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вызовите расширенную панель в любой момент; нажмите снова, чтобы закрыть."
          }
        }
      }
    },
